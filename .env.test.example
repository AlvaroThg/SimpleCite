# ─────────────────────────────────────────────
# SimpleCite — TEST
# Copia este archivo a `.env.test` (gitignored).
# Apunta a una base de datos efímera (CI o local de pruebas).
# ─────────────────────────────────────────────

NODE_ENV="test"

# ─── Database de test (típicamente local, NUNCA producción) ───
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/simplecite_test"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/simplecite_test"

# ─── Supabase (valores dummy aceptables en CI) ───
SUPABASE_URL="https://test.supabase.co"
SUPABASE_ANON_KEY="test-anon-key"
SUPABASE_SERVICE_ROLE_KEY="test-service-role-key"

# ─── JWT ───
JWT_SECRET="test-secret-of-at-least-32-characters-long-xx"
JWT_EXPIRATION="1h"

# ─── App ───
API_PORT=3001
WEB_PORT=3000
APP_DOMAIN="simplecite.test"

# Todas las integraciones externas se mockean en tests
QR_SIMPLE_API_URL=""
QR_SIMPLE_API_KEY=""
QR_SIMPLE_WEBHOOK_SECRET=""
WHATSAPP_ORCHESTRATOR_URL=""
WHATSAPP_ORCHESTRATOR_TOKEN=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
TURNSTILE_SECRET_KEY=""

# ─── Patient OTP (test) ───
PATIENT_JWT_SECRET="test-patient-secret-of-at-least-32-characters-long"
PATIENT_SESSION_TTL="5m"
OTP_TTL_MINUTES=5
TENTATIVE_APPOINTMENT_TTL_MINUTES=5
