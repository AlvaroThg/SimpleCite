# ─────────────────────────────────────────────
# SimpleCite — DEVELOPMENT
# Copia este archivo a `.env.development` (gitignored).
# ─────────────────────────────────────────────

NODE_ENV="development"

# ─── App ───
API_PORT=3001
WEB_PORT=3000
APP_DOMAIN="simplecite.local"

# ─── Database ───
# Con el Postgres del docker-compose (servicio `db`), apunta a simplecite-db:5432.
# Sin pgBouncer: DATABASE_URL y DIRECT_URL son la misma URL directa.
DATABASE_URL="postgresql://simplecite:devpass@simplecite-db:5432/simplecite?schema=public"
DIRECT_URL="postgresql://simplecite:devpass@simplecite-db:5432/simplecite?schema=public"
# (Opcional) credenciales que consume el servicio `db` del compose:
POSTGRES_USER="simplecite"
POSTGRES_PASSWORD="devpass"
POSTGRES_DB="simplecite"

# ─── JWT staff (firmado por NestJS, mínimo 32 chars) ───
JWT_SECRET="dev-change-me-to-a-random-string-of-at-least-32-characters"
JWT_EXPIRATION="24h"

# ─── Sesión de paciente / OTP (secret SEPARADO del JWT de staff) ───
PATIENT_JWT_SECRET="dev-patient-change-me-to-another-random-string-32+chars"
PATIENT_SESSION_TTL="30m"
OTP_TTL_MINUTES=10
TENTATIVE_APPOINTMENT_TTL_MINUTES=15

# ─── Next.js Web (split SSR/navegador — ver lib/api-base.ts) ───
NEXT_PUBLIC_API_URL="http://localhost:3001"      # navegador (se inlinea en build)
INTERNAL_API_URL="http://simplecite-api:3001"    # SSR dentro del contenedor web
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sb-xxxx"
NEXT_PUBLIC_PAYPAL_PLAN_ID="P-xxxx"

# ─── Cloudflare R2 (opcional en dev; sin esto las subidas fallan) ───
R2_ACCOUNT_ID=""
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="simplecite"
R2_PUBLIC_URL=""

# ─── PayPal (SIEMPRE Sandbox en dev) ───
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID="sb-xxxx-client-id"
PAYPAL_CLIENT_SECRET="sb-xxxx-secret"
PAYPAL_WEBHOOK_ID="WH-xxxx"

# ─── WhatsApp Instance Manager ───
WA_DOCKER_NETWORK="simplecite-internal"
WA_CALLBACK_URL="http://simplecite-api:3001/api/internal/whatsapp/webhook"
WA_INTERNAL_SECRET="dev-wa-internal-secret-change-in-prod"
WA_INSTANCE_IMAGE="simplecite-wa-instance:latest"

# ─── Cloudflare Turnstile (anti-bot) — opcional en dev (vacío = sin verificación) ───
TURNSTILE_SECRET_KEY=""

# ─── RLS ───
# false = RLS dormante (sin transacción por request → menos latencia).
# true  = enforcement real (requiere rol sin bypassrls — ver docs/rls-enforcement.md).
RLS_ENFORCED="false"
