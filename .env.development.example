# ─────────────────────────────────────────────
# SimpleCite — DEVELOPMENT
# Copia este archivo a `.env.development` (gitignored).
# ─────────────────────────────────────────────

NODE_ENV="development"

# ─── Database (Supabase Transaction Pooler para Prisma) ───
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── Supabase ───
SUPABASE_URL="https://ohiaornlzikzgibptagp.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── JWT (firmado por NestJS, mínimo 32 chars) ───
JWT_SECRET="dev-change-me-to-a-random-string-of-at-least-32-characters"
JWT_EXPIRATION="24h"

# ─── App ───
API_PORT=3001
WEB_PORT=3000
APP_DOMAIN="simplecite.local"

# ─── Next.js Web (public vars expuestas al browser) ───
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ─── QR Simple (Bolivia) — opcionales en dev ───
QR_SIMPLE_API_URL=""
QR_SIMPLE_API_KEY=""
QR_SIMPLE_WEBHOOK_SECRET=""

# ─── WhatsApp Instance Manager (Fase 5) ───
WA_DOCKER_NETWORK="simplecite-internal"
WA_CALLBACK_URL="http://simplecite-api:3001/api/internal/whatsapp/webhook"
WA_INTERNAL_SECRET="dev-wa-internal-secret-change-in-prod"
WA_INSTANCE_IMAGE="simplecite-wa-instance:latest"

# ─── WhatsApp Orchestrator — obsoleto ───
WHATSAPP_ORCHESTRATOR_URL=""
WHATSAPP_ORCHESTRATOR_TOKEN=""

# ─── Cloudflare — opcionales en dev ───
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# ─── Cloudflare Turnstile (bot protection) — opcional en dev ───
# Vacío en dev = sin verificación. En prod debería estar seteado.
TURNSTILE_SECRET_KEY=""

# ─── Patient OTP / Sesión de paciente ───
# Secret SEPARADO del JWT_SECRET para limitar el blast radius.
PATIENT_JWT_SECRET="dev-patient-change-me-to-another-random-string-32+chars"
PATIENT_SESSION_TTL="30m"
OTP_TTL_MINUTES=10
TENTATIVE_APPOINTMENT_TTL_MINUTES=15
