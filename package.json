{
  "name": "simplecite",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS Multi-tenant para gestión de consultorios médicos en Bolivia",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=api",
    "dev:web": "turbo run dev --filter=web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "db:generate": "pnpm --filter @simplecite/database db:generate",
    "db:migrate:dev": "pnpm --filter @simplecite/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @simplecite/database db:migrate:deploy",
    "db:seed": "pnpm --filter @simplecite/database db:seed",
    "db:studio": "pnpm --filter @simplecite/database db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "eslint": "^9.27.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
