# ─── Database (Supabase PostgreSQL) ───
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# ─── Supabase ───
SUPABASE_URL="https://ohiaornlzikzgibptagp.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── JWT (Firmado por NestJS) ───
JWT_SECRET="change-me-to-a-random-string-of-at-least-32-characters"
JWT_EXPIRATION="24h"

# ─── App ───
NODE_ENV="development"
API_PORT=3001
WEB_PORT=3000
APP_DOMAIN="simplecite.com.bo"

# ─── PayPal (suscripciones — SANDBOX en dev) ───
# Backend (API): credenciales de la app Sandbox + id del webhook.
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID="sb-xxxx-client-id"
PAYPAL_CLIENT_SECRET="sb-xxxx-secret"
PAYPAL_WEBHOOK_ID="WH-xxxx"   # de PayPal Dashboard → Webhooks (necesario para verificar firmas)
# Frontend (Next, públicas). Si Next no toma este archivo, ponlas en apps/web/.env.local
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sb-xxxx-client-id"
NEXT_PUBLIC_PAYPAL_PLAN_ID="P-xxxx"   # Plan ID de suscripción de prueba

# ─── Instagram feed (landing del tenant — widget gratuito, sin API de Meta) ───
# ID del widget de LightWidget (lightwidget.com). Si está vacío, la landing
# muestra un CTA al perfil de Instagram en vez del feed embebido.
NEXT_PUBLIC_LIGHTWIDGET_ID=""

# ─── WhatsApp Cloud API (Meta — bot centralizado oficial) ───
# En dev puedes dejarlas vacías: los envíos se loguean y se omiten (no rompen).
META_WA_BASE_URL="https://graph.facebook.com/v19.0"
META_WA_PHONE_NUMBER_ID=""        # Meta → WhatsApp → API Setup → Phone number ID
META_WA_ACCESS_TOKEN=""           # Token de System User para la Graph API
META_WA_VERIFY_TOKEN="dev-verify-token"   # mismo valor en el webhook de Meta
META_WA_APP_SECRET=""             # App secret (verifica firma del webhook); vacío = sin verificar (dev)
WEB_PUBLIC_URL="http://localhost:3000"    # base del frontend para el magic link de cancelación

# ─── Cloudflare R2 (almacenamiento de archivos: logos, comprobantes) ───
R2_ACCOUNT_ID="tu-account-id"                       # Cloudflare → R2 → Account ID
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"  # opcional si pones R2_ACCOUNT_ID
R2_ACCESS_KEY_ID="r2-access-key-id"                 # R2 → Manage API Tokens
R2_SECRET_ACCESS_KEY="r2-secret-access-key"
R2_BUCKET="simplecite"                              # nombre del bucket en R2
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"             # URL pública del bucket (r2.dev o dominio propio)

# ─── Despliegue self-hosted (Dokploy + Postgres en contenedor) ───
# Postgres interno de Dokploy: usa el hostname del servicio. Sin pgBouncer,
# DATABASE_URL y DIRECT_URL apuntan a la MISMA URL directa (puerto 5432).
# DATABASE_URL="postgresql://USER:PASS@<servicio-db-dokploy>:5432/simplecite?schema=public"
# DIRECT_URL="postgresql://USER:PASS@<servicio-db-dokploy>:5432/simplecite?schema=public"
