# ─── Database (Supabase PostgreSQL) ───
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# ─── Supabase ───
SUPABASE_URL="https://ohiaornlzikzgibptagp.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── JWT (Firmado por NestJS) ───
JWT_SECRET="change-me-to-a-random-string-of-at-least-32-characters"
JWT_EXPIRATION="24h"

# ─── App ───
NODE_ENV="development"
API_PORT=3001
WEB_PORT=3000
APP_DOMAIN="simplecite.com.bo"

# ─── PayPal (suscripciones — SANDBOX en dev) ───
# Backend (API): credenciales de la app Sandbox + id del webhook.
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID="sb-xxxx-client-id"
PAYPAL_CLIENT_SECRET="sb-xxxx-secret"
PAYPAL_WEBHOOK_ID="WH-xxxx"   # de PayPal Dashboard → Webhooks (necesario para verificar firmas)
# Frontend (Next, públicas). Si Next no toma este archivo, ponlas en apps/web/.env.local
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sb-xxxx-client-id"
NEXT_PUBLIC_PAYPAL_PLAN_ID="P-xxxx"   # Plan ID de suscripción de prueba
