# ─────────────────────────────────────────────
# SimpleCite — PRODUCTION
# NO commitear el archivo `.env.production` real.
# Cargar estas variables desde el provider (Vercel/Fly/Render/Docker secrets).
# Las variables marcadas como REQUIRED son obligatorias en prod (assertProductionInvariants).
# ─────────────────────────────────────────────

NODE_ENV="production"

# ─── Database (REQUIRED) ───
DATABASE_URL=""   # REQUIRED — Supabase pooler URL
DIRECT_URL=""     # REQUIRED — Supabase direct URL (para migraciones)

# ─── Supabase (REQUIRED) ───
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── JWT (REQUIRED, rotar periódicamente) ───
JWT_SECRET=""     # REQUIRED — mínimo 32 caracteres aleatorios
JWT_EXPIRATION="12h"

# ─── App ───
API_PORT=3001
WEB_PORT=3000
APP_DOMAIN="simplecite.com.bo"

# ─── QR Simple (REQUIRED en prod) ───
QR_SIMPLE_API_URL=""
QR_SIMPLE_API_KEY=""
QR_SIMPLE_WEBHOOK_SECRET=""   # mínimo 16 chars — valida HMAC del webhook

# ─── WhatsApp Orchestrator (REQUIRED en prod) ───
WHATSAPP_ORCHESTRATOR_URL=""
WHATSAPP_ORCHESTRATOR_TOKEN=""

# ─── Cloudflare ───
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# ─── Cloudflare Turnstile (REQUIRED en prod) ───
TURNSTILE_SECRET_KEY=""   # REQUIRED — secret key del widget Turnstile

# ─── Patient OTP / Sesión de paciente (REQUIRED) ───
PATIENT_JWT_SECRET=""     # REQUIRED — secret separado del JWT_SECRET de staff
PATIENT_SESSION_TTL="30m"
OTP_TTL_MINUTES=10
TENTATIVE_APPOINTMENT_TTL_MINUTES=15
