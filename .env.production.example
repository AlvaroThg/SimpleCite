# ─────────────────────────────────────────────
# SimpleCite — PRODUCTION (self-hosted: Dokploy + Postgres + Cloudflare R2)
# NO commitear el archivo `.env.production` real. Cargar estas variables desde
# Dokploy (Environment de cada app), no desde un archivo en la imagen.
# Las marcadas REQUIRED en prod las valida assertProductionInvariants (env.ts).
# ─────────────────────────────────────────────

NODE_ENV="production"

# ─── App ───
API_PORT=3001
WEB_PORT=3000
APP_DOMAIN="simplecite.com.bo"

# ─── Database (Postgres propio — Dokploy) ───
# Sin pgBouncer: DATABASE_URL y DIRECT_URL apuntan a la MISMA URL directa (5432).
DATABASE_URL=""   # REQUIRED — postgresql://USER:PASS@<host-db>:5432/simplecite?schema=public
DIRECT_URL=""     # REQUIRED en prod — igual que DATABASE_URL (para migrate deploy)

# ─── JWT staff (REQUIRED, rotar periódicamente) ───
JWT_SECRET=""     # REQUIRED — mínimo 32 caracteres aleatorios
JWT_EXPIRATION="12h"

# ─── Sesión de paciente / OTP (REQUIRED) ───
PATIENT_JWT_SECRET=""     # REQUIRED — secret SEPARADO del JWT_SECRET de staff (32+)
PATIENT_SESSION_TTL="30m"
OTP_TTL_MINUTES=10
TENTATIVE_APPOINTMENT_TTL_MINUTES=15

# Booking público sin bot: dejar en false (flujo abierto con Turnstile + rate
# limit). Poner en true solo cuando el bot de WhatsApp esté activo (OTP).
PUBLIC_BOOKING_REQUIRE_OTP=false
# Anti-bot del booking abierto (recomendado en prod). El site key es público.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ─── Cloudflare R2 (almacenamiento: logos, QR estático, comprobantes) ───
# REQUIRED en prod (sin esto las subidas fallan).
R2_ACCOUNT_ID=""                  # o usa R2_ENDPOINT directo
R2_ENDPOINT=""                    # https://<accountid>.r2.cloudflarestorage.com (opcional si das ACCOUNT_ID)
R2_ACCESS_KEY_ID=""               # REQUIRED
R2_SECRET_ACCESS_KEY=""           # REQUIRED
R2_BUCKET="simplecite"            # REQUIRED
R2_PUBLIC_URL=""                  # REQUIRED — https://pub-xxxx.r2.dev o dominio propio

# ─── Frontend (web) — URLs ───
# Pública del frontend (Build Arg de la app web en Dokploy):
NEXT_PUBLIC_API_URL="https://api.simplecite.com.bo"   # navegador
# Runtime de la app web: SSR por red interna (no sale a internet)
INTERNAL_API_URL="http://api:3001"

# ─── WhatsApp Instance Manager (LEGACY Baileys — en desuso tras Cloud API) ───
WA_DOCKER_NETWORK="simplecite-internal"
WA_CALLBACK_URL="http://simplecite-api:3001/api/internal/whatsapp/webhook"  # ajustar al nombre real del contenedor API
WA_INTERNAL_SECRET=""             # REQUIRED en prod — mínimo 16 chars
WA_INSTANCE_IMAGE="simplecite-wa-instance:latest"   # construir en el host del VPS

# ─── WhatsApp Cloud API (Meta — bot centralizado oficial) ───
# Modelo "bot centralizado": un único número oficial de la plataforma.
META_WA_BASE_URL="https://graph.facebook.com/v19.0"  # base versionada de la Graph API
META_WA_PHONE_NUMBER_ID=""        # Meta → WhatsApp → API Setup → Phone number ID
META_WA_ACCESS_TOKEN=""           # Token permanente de System User (Graph API)
META_WA_VERIFY_TOKEN=""           # String propio; el mismo que pongas en el webhook de Meta
META_WA_APP_SECRET=""             # App secret de Meta → verifica firma X-Hub-Signature-256
WEB_PUBLIC_URL="https://simplecite.com.bo"  # base del frontend para el magic link de cancelación

# ─── Mensajería al paciente (bot) ───
MESSAGING_PROVIDER="whatsapp"   # en prod: whatsapp. Para pruebas: telegram.
TELEGRAM_BOT_TOKEN=""           # solo si MESSAGING_PROVIDER=telegram

# ─── Cloudflare Turnstile (anti-bot en endpoints públicos) ───
# Vacío = sin verificación (el frontend aún no monta el widget).
TURNSTILE_SECRET_KEY=""

# ─── Observabilidad (Grafana — Loki/Prometheus/Promtail se autoconfiguran) ───
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD=""          # REQUIRED — password fuerte
GRAFANA_ROOT_URL="https://grafana.simplecite.com.bo"   # dominio de Grafana en Dokploy

# ─── RLS (ver docs/rls-enforcement.md) ───
RLS_ENFORCED="false"
