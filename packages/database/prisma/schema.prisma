// This is the SimpleCite Prisma schema.
// Source of truth for the database model.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // native: para dev local (Windows / macOS / Linux glibc)
  // linux-musl-openssl-3.0.x: para Alpine Linux (Docker / VPS)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────
// ENUMS
// ─────────────────────────────────────

enum UserRole {
  ADMIN
  DOCTOR
  STAFF
}

enum AppointmentStatus {
  /// Reservado pero aún sin confirmar (durante el flujo OTP).
  /// Expira a través de `expiresAt`; el slot queda bloqueado mientras tanto.
  TENTATIVE
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SubscriptionPlan {
  BASIC
  PRO
  ELITE
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum WaInstanceStatus {
  CREATING /// Registro creado en DB, contenedor no existe aún
  STARTING /// Contenedor creado y arrancado, Baileys inicializando
  PAIRING /// Esperando que el usuario escanee el QR
  CONNECTED /// Sesión WhatsApp activa
  DISCONNECTED /// Desconectado (reconectando automáticamente)
  ERROR /// Error no recuperable (container crashed, imagen faltante, etc.)
  STOPPED /// Detenido manualmente por admin
}

enum WaMessageStatus {
  PENDING
  SENT
  FAILED
}

enum PaymentStatus {
  PENDING /// Intent creado, esperando confirmación de pago
  PAID /// Pago confirmado vía webhook
  FAILED /// Pago rechazado/fallido
  EXPIRED /// Intent expiró sin pagarse (lo marca el cron de conciliación)
}

enum NoteVisibility {
  PRIVATE /// Visible solo para author, doctor asignado y roles autorizados (default)
}

enum PaymentMethod {
  CASH /// Efectivo en la clínica
  STATIC_QR /// QR bancario estático — paciente envía comprobante por WhatsApp
  INSURANCE /// Cobertura por seguro médico — no hay cobro al paciente
}

enum QrAssignmentMode {
  SHARED /// Un único QR del tenant para toda la clínica (default)
  PER_DOCTOR /// Cada doctor tiene su propio QR; el booking muestra el del doctor de la cita
}

enum ProductCategory {
  MEDICATION /// Medicamento
  SUPPLY /// Insumo / material
  OTHER /// Otro producto vendible
}

// ─────────────────────────────────────
// MODELS
// ─────────────────────────────────────

/// Organización / Clínica — Raíz de la jerarquía multi-tenant.
model Tenant {
  id           String           @id @default(uuid())
  slug         String           @unique /// Subdominio: clinica-tarija.simplecite.com.bo
  name         String
  logoUrl      String?
  primaryColor String           @default("#3B82F6") /// Color corporativo para la landing
  plan         SubscriptionPlan @default(BASIC)
  status       TenantStatus     @default(TRIAL)
  timezone     String           @default("America/La_Paz") /// Timezone Bolivia

  // Pagos: hasta 2 QR estáticos bancarios (el segundo es alternativa de respaldo)
  staticQrUrl    String? /// URL de la imagen del QR bancario estático (principal)
  staticQrLabel  String? /// Nombre del banco del QR principal (ej. "Banco Unión")
  staticQrUrl2   String? /// URL del segundo QR (banco alternativo)
  staticQrLabel2 String? /// Nombre del banco del segundo QR

  /// Cómo se asigna el QR de cobro: compartido (tenant) o por doctor.
  qrAssignmentMode QrAssignmentMode @default(SHARED)

  // ─── Personalización de la landing pública (editable por el admin) ───
  secondaryColor   String? /// Color secundario de la paleta (hex). Acentos/gradientes.
  heroImageUrl     String? /// Imagen de portada (hero) de la landing del tenant
  heroTitle        String? /// Título del hero (si null, se usa uno por defecto)
  heroSubtitle     String? /// Subtítulo del hero
  servicesTitle    String? /// Título de la sección de servicios
  specialistsTitle String? /// Título de la sección de especialistas
  ctaTitle         String? /// Título del bloque CTA final
  ctaSubtitle      String? /// Subtítulo del bloque CTA final

  // ─── Suscripción / Billing (gestión manual en DB, sin pasarela) ───
  subscriptionStatus  String    @default("TRIAL") /// TRIAL | ACTIVE | PAST_DUE | CANCELED
  subscriptionEndDate DateTime? /// Fin del período pagado; el SubscriptionGuard valida contra NOW()

  // ─── Contacto y redes (footer de la landing pública) ───
  address          String? /// Dirección física (footer + modal de Google Maps)
  facebookUrl      String?
  instagramUrl     String?
  whatsappContact  String? /// Número de contacto público (E.164 sin '+')
  /// Foto exterior/fachada del consultorio. Separado de heroImageUrl
  /// (marketing) — propósito es referencia física para el paciente.
  locationPhotoUrl String?
  /// Link de Google Maps de la clínica (compartido desde la app de Maps).
  /// Si es null, los botones de mapa generan una búsqueda desde `address`.
  mapsUrl          String?

  // Configuración de WhatsApp
  whatsappEnabled Boolean @default(false)
  whatsappNumber  String? /// El número vinculado al bot

  // Relaciones
  users             User[]
  patients          Patient[]
  services          Service[]
  appointments      Appointment[]
  whatsappInstances WhatsappInstance[]
  medicalRecords    MedicalRecord[]
  prescriptions     Prescription[]
  products          Product[]
  tenantInsurances  TenantInsurance[]
  doctorInsurances  DoctorInsurance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenants")
}

/// Usuario del sistema — Doctor, Staff o Admin de una clínica.
model User {
  id       String   @id @default(uuid())
  email    String
  password String
  name     String
  role     UserRole @default(DOCTOR)
  isActive Boolean  @default(true)
  /// Teléfono de contacto (E.164 sin '+', ej: 59170000000). Capturado en el onboarding del admin.
  phone    String?

  // Relación con el Tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relaciones Médicas
  appointments   Appointment[] /// Citas asignadas a este doctor
  medicalNotes   MedicalNote[] /// Notas creadas por este doctor
  medicalRecords MedicalRecord[] /// Historias clínicas redactadas por este doctor
  prescriptions  Prescription[] /// Recetas emitidas por este doctor

  // Profiles 1:1 — solo uno aplica según role
  doctorProfile DoctorProfile?
  staffProfile  StaffProfile?

  // Catálogo y agenda del doctor
  doctorServices       DoctorService[]
  doctorScheduleRules  DoctorScheduleRule[]
  doctorScheduleBlocks DoctorScheduleBlock[]
  /// Seguros médicos asignados a este doctor (solo aplica con insuranceMode).
  insuranceAssignments DoctorInsurance[]
  /// Productos privados del doctor (Opción A: doctorId en Product).
  ownedProducts        Product[]         @relation("DoctorProducts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([tenantId, id])
  @@map("users")
}

/// Perfil extendido para usuarios con role DOCTOR.
model DoctorProfile {
  id            String  @id @default(uuid())
  specialty     String /// Ej: "Medicina General", "Cardiología"
  licenseNumber String? /// Matrícula profesional
  bio           String? @db.Text

  /// QR bancario propio del doctor (solo aplica si el tenant usa PER_DOCTOR).
  qrUrl   String?
  qrLabel String? /// Nombre del banco del QR del doctor

  /// Si true, las citas con este doctor van por seguro, no por cobro directo.
  insuranceMode Boolean @default(false)

  /// URL pública en Cloudflare R2. Foto del especialista (booking + landing).
  photoUrl String?

  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String /// Denormalizado para scope RLS directo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("doctor_profiles")
}

/// Perfil extendido para usuarios con role STAFF (recepción, administración).
model StaffProfile {
  id       String  @id @default(uuid())
  position String /// Ej: "Recepcionista", "Administrador de caja"
  notes    String?

  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("staff_profiles")
}

/// Paciente — Pertenece a una clínica específica por privacidad de datos.
/// Identidad deduplicada por (tenantId, phone) y (tenantId, ci) normalizados.
model Patient {
  id    String  @id @default(uuid())
  name  String
  phone String /// E.164 sin '+' (ej: 59170000000) — normalizado al persistir
  ci    String? /// Cédula de Identidad para validación médica/pagos

  // Un paciente "pertenece" a una clínica por privacidad
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  appointments   Appointment[]
  medicalNotes   MedicalNote[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phone, tenantId]) /// El mismo número no puede duplicarse en la misma clínica
  // Nota: unicidad de (ci, tenantId) se aplica con un índice parcial
  // (WHERE ci IS NOT NULL) en la migración, ya que ci es opcional.
  @@index([tenantId])
  @@index([tenantId, id])
  @@index([tenantId, ci]) /// Lookup/dedupe por cédula
  @@map("patients")
}

/// Servicio ofrecido por una clínica (ej: "Consulta General", "Sesión Fisioterapia").
model Service {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2) /// Precio en Bolivianos (Bs)
  duration    Int /// Duración en minutos
  isActive    Boolean @default(true)
  /// Clave de ícono para la landing (mirror de ServiceIcon en @simplecite/shared).
  icon        String?
  /// Color hex (#RRGGBB) del servicio — pinta las citas no terminadas en el
  /// calendario del panel. Si es null, se usa el azul de marca por defecto.
  color       String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  appointments   Appointment[]
  doctorServices DoctorService[] /// Doctores que ofrecen este servicio

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, tenantId]) /// Evita servicios duplicados dentro de la misma clínica
  @@index([tenantId])
  @@index([tenantId, id])
  @@map("services")
}

/// Cita médica — Relación central entre Paciente, Doctor y Servicio.
model Appointment {
  id        String            @id @default(uuid())
  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(PENDING_PAYMENT)

  // Relaciones
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId String
  doctor   User   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  paymentMethod PaymentMethod @default(CASH)
  /// URL del comprobante de pago enviado por el paciente vía WhatsApp.
  receiptUrl    String?

  /// Seguro que cubre esta cita (solo paymentMethod=INSURANCE).
  tenantInsuranceId String?
  tenantInsurance   TenantInsurance? @relation(fields: [tenantInsuranceId], references: [id], onDelete: SetNull)

  /// Nombre del seguro en el momento de crear la cita — INMUTABLE.
  /// Fuente de verdad para PDFs y reportes históricos independientemente
  /// de si el admin renombra o archiva el seguro después.
  insuranceNameSnapshot String?

  /// Monto cobrado por esta cita, congelado al crearla: customPrice del doctor
  /// para el servicio ?? precio del servicio. Fuente de verdad para reportes.
  /// Null en citas legacy → los reportes caen al precio actual del servicio.
  price Decimal? @db.Decimal(10, 2)

  /// Token criptográfico para cancelación por magic link enviado por WhatsApp.
  /// Se genera al crear la cita (crypto.randomBytes). Único; null en citas
  /// legacy o cuando no aplica cancelación self-service.
  cancellationToken String? @unique

  // Campos legacy de QR Simple dinámico (sin uso en MVP estático, preservados para migración futura)
  qrPayload String?
  isPaid    Boolean @default(false)

  paymentIntents PaymentIntent[]
  medicalNotes   MedicalNote[]
  /// Historia clínica estructurada de esta cita (1-1, creada en la consulta).
  medicalRecord  MedicalRecord?

  /// TTL para citas TENTATIVE (flujo público de reserva).
  /// Si NOW() > expiresAt y status=TENTATIVE, un job/cleanup la marca CANCELLED.
  /// `null` para citas creadas por staff/admin (no expiran).
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, id])
  @@index([tenantId, doctorId])
  @@index([tenantId, patientId])
  @@index([startTime, endTime])
  @@map("appointments")
}

/// Nota clínica / Historial — Dato sensible. Aislamiento por tenant +
/// control de acceso por rol a nivel de servicio (author / doctor-asignado /
/// admin pueden leer; staff no accede a contenido clínico).
/// `doctorId` es el autor de la nota (author_user_id del spec EHR).
model MedicalNote {
  id      String @id @default(uuid())
  content String @db.Text /// El historial clínico en sí

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// Autor de la nota (doctor o admin que la escribió).
  doctorId String
  doctor   User   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  /// Cita asociada (opcional — una nota puede no estar atada a una cita puntual).
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  visibility NoteVisibility @default(PRIVATE)

  // tenantId explícito — fuente de verdad del aislamiento (filtro app-layer)
  tenantId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, patientId, createdAt]) /// Historial cronológico paginado
  @@index([appointmentId])
  @@map("medical_notes")
}

/// Historia clínica estructurada de una consulta. Relación 1-1 con Appointment:
/// se crea/edita al atender al paciente (módulo "Consulta en Curso").
/// Dato sensible — mismo modelo de acceso que MedicalNote (tenant + rol).
model MedicalRecord {
  id String @id @default(uuid())

  /// Cita atendida — 1-1. Una cita tiene como máximo una historia clínica.
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// Doctor que redactó la historia.
  doctorId String
  doctor   User   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  /// Aislamiento por tenant (filtro app-layer / scope RLS).
  tenantId String

  symptoms     String? @db.Text /// Motivo de consulta / síntomas referidos
  diagnosis    String? @db.Text /// Diagnóstico
  treatment    String? @db.Text /// Plan de tratamiento / indicaciones
  privateNotes String? @db.Text /// Notas privadas del doctor (no se imprimen al paciente)

  /// Etiqueta libre del tratamiento (ej: "Fisioterapia rodilla — sesión 1").
  treatmentLabel String?
  /// Marca esta consulta como el inicio de un nuevo tratamiento.
  isNewTreatment Boolean @default(false)

  /// Receta(s) generadas en esta consulta.
  prescriptions Prescription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, doctorId])
  @@map("medical_records")
}

/// Receta digital emitida en una consulta. Vinculada a la historia clínica
/// (que a su vez referencia la cita). El campo `medications` es JSON: una lista
/// de items { name, dose, frequency, duration }. Genera un PDF descargable.
model Prescription {
  id String @id @default(uuid())

  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// Doctor que emite la receta.
  doctorId String
  doctor   User   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  tenantId String

  /// Lista de medicamentos: [{ name, dose, frequency, duration }, ...]
  medications  Json
  /// Indicaciones generales (texto libre) para el paciente.
  instructions String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([medicalRecordId])
  @@map("prescriptions")
}

/// Producto del mini-inventario de la clínica: medicamentos, insumos u otros
/// vendibles. Se puede referenciar desde una receta y controlar su stock.
model Product {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Dueño del producto (Opción A): null = producto de la clínica (todos lo
  /// ven); no-null = producto privado del doctor (solo él y el admin lo ven).
  doctorId String?
  doctor   User?   @relation("DoctorProducts", fields: [doctorId], references: [id], onDelete: SetNull)

  name     String
  /// Código interno / SKU opcional.
  sku      String?
  category ProductCategory @default(MEDICATION)
  /// Unidad de despacho: "caja", "unidad", "ml", "mg", etc.
  unit     String          @default("unidad")
  /// Precio de venta en Bolivianos (Bs).
  price    Decimal         @default(0) @db.Decimal(10, 2)

  /// Existencias actuales (ajuste manual en el MVP).
  stock             Int     @default(0)
  /// Umbral para alertar stock bajo (null = sin alerta).
  lowStockThreshold Int?
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, tenantId]) /// No duplicar el mismo producto en la clínica
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, doctorId])
  @@map("products")
}

/// Seguro médico aceptado por la clínica. Catálogo que define el admin una vez;
/// luego se asigna por doctor vía DoctorInsurance. Archivado = isActive:false
/// (las citas históricas conservan insuranceNameSnapshot).
model TenantInsurance {
  id       String  @id @default(uuid())
  name     String /// "Univida", "Universitario", "COSSMIL", etc.
  isActive Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  doctorAssignments DoctorInsurance[]
  appointments      Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, tenantId])
  @@index([tenantId])
  @@map("tenant_insurances")
}

/// Asignación M:N doctor ↔ seguro: subconjunto del catálogo del tenant que un
/// doctor específico acepta. Desasignar = isActive:false (soft, reversible).
model DoctorInsurance {
  id       String  @id @default(uuid())
  isActive Boolean @default(true)

  doctorId String
  doctor   User   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  tenantInsuranceId String
  tenantInsurance   TenantInsurance @relation(fields: [tenantInsuranceId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, tenantInsuranceId])
  @@index([doctorId])
  @@index([tenantInsuranceId])
  @@index([tenantId])
  @@map("doctor_insurances")
}

/// Catálogo de servicios que ofrece un doctor específico.
/// Permite override de duración/precio default del Service catálogo.
model DoctorService {
  id String @id @default(uuid())

  doctorId String
  doctor   User   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  tenantId String /// Denorm para scope RLS directo

  /// Si está presente, sobreescribe Service.duration (minutos)
  customDuration Int?
  /// Si está presente, sobreescribe Service.price (Bs)
  customPrice    Decimal? @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, serviceId]) /// Un doctor no repite el mismo servicio
  @@index([tenantId])
  @@index([tenantId, doctorId])
  @@map("doctor_services")
}

/// Regla semanal recurrente del horario de un doctor.
/// Múltiples reglas por día representan rangos (ej: 8-12 + 14-18 = break implícito 12-14).
model DoctorScheduleRule {
  id String @id @default(uuid())

  doctorId String
  doctor   User   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  tenantId String

  /// 0 = Domingo … 6 = Sábado (compatible con JavaScript Date.getDay())
  dayOfWeek Int

  /// Minutos desde medianoche en la timezone del tenant (0-1439)
  startMinute Int
  endMinute   Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, doctorId, dayOfWeek])
  @@map("doctor_schedule_rules")
}

/// Bloqueo puntual del horario: vacaciones, días libres, feriados específicos del doctor.
/// Tiene precedencia sobre DoctorScheduleRule en el motor de slots.
model DoctorScheduleBlock {
  id String @id @default(uuid())

  doctorId String
  doctor   User   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  tenantId String

  /// Datetime UTC. Para "todo el día", usar 00:00:00–23:59:59 en local time del tenant.
  startTime DateTime
  endTime   DateTime
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, doctorId])
  @@index([startTime, endTime])
  @@map("doctor_schedule_blocks")
}

/// OTP para login invisible de paciente (vía WhatsApp).
/// El código se almacena hasheado con bcrypt; nunca en texto plano.
/// Cada (tenant, phone) puede tener varios; se usa el más reciente no consumido.
model PatientOtp {
  id       String @id @default(uuid())
  tenantId String /// Scope RLS — derivado del slug del tenant en la URL pública
  phone    String /// Formato E.164 sin '+', ej: 59170000000
  codeHash String /// bcrypt(otp_de_6_dígitos)

  expiresAt  DateTime /// now + 10 min al crearse
  attempts   Int       @default(0) /// Verificaciones fallidas — se invalida al pasar 5
  consumedAt DateTime?

  /// IP de origen de la solicitud — para rate limiting por IP backed por DB.
  requestIp String?

  createdAt DateTime @default(now())

  @@index([tenantId, phone, createdAt]) /// Buscar último OTP + rate limit por phone
  @@index([requestIp, createdAt]) /// Rate limit por IP
  @@index([expiresAt]) /// Cleanup batch de OTPs expirados
  @@map("patient_otps")
}

/// Instancia de WhatsApp por tenant. Un contenedor Baileys por fila.
/// El orquestador (NestJS InstanceManagerService) crea/destruye contenedores
/// usando el Docker socket y mantiene esta tabla como source of truth.
model WhatsappInstance {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Nombre del contenedor Docker: `wa-{tenant.slug}`
  containerName String  @unique
  /// ID del contenedor (sha256 corto). Null si está en estado CREATING/ERROR.
  containerId   String?
  /// Puerto interno del contenedor en la red Docker (siempre 4000).
  /// Guardado para referencia; el acceso es por nombre de contenedor en red interna.
  internalPort  Int     @default(4000)

  status       WaInstanceStatus @default(CREATING)
  /// Número de teléfono vinculado (E.164 sin '+') tras QR exitoso.
  phone        String?
  lastSeen     DateTime?
  restartCount Int              @default(0)

  messages      WhatsappMessage[]
  conversations WaConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("whatsapp_instances")
}

/// Mensaje enviado por WhatsApp (OTP u otros). Idempotencia por messageKey.
/// El orquestador reintenta hasta MAX_ATTEMPTS veces; el estado final es SENT o FAILED.
model WhatsappMessage {
  id         String           @id @default(uuid())
  tenantId   String
  instanceId String
  instance   WhatsappInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  /// Clave de idempotencia: el caller la genera y el servicio la respeta.
  /// Si ya existe un registro con esta key, NO se reenvía.
  messageKey String @unique
  phone      String
  text       String

  status   WaMessageStatus @default(PENDING)
  attempts Int             @default(0)
  error    String?
  sentAt   DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([instanceId])
  @@index([status, attempts]) /// Para re-enqueue de mensajes PENDING con pocos intentos
  @@map("whatsapp_messages")
}

enum WaConversationState {
  IDLE
  AWAITING_DOCTOR
  AWAITING_SERVICE
  AWAITING_DATE
  AWAITING_SLOT
  AWAITING_NAME
  AWAITING_OTP
  AWAITING_PAYMENT_METHOD
  COMPLETED
}

/// Estado conversacional de un paciente interactuando con el bot por WhatsApp.
/// Una conversación por (tenant, phone). Expira tras 30 min de inactividad.
model WaConversation {
  id         String           @id @default(uuid())
  tenantId   String
  instanceId String
  instance   WhatsappInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  phone   String
  state   WaConversationState @default(IDLE)
  /// Contexto JSON: doctor seleccionado, servicio, fecha, slot, etc.
  context Json                @default("{}")

  lastMessageAt DateTime @default(now())
  /// La conversación expira si no hay actividad en 30 min.
  expiresAt     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, phone]) /// Una conversación activa por paciente
  @@index([tenantId])
  @@index([expiresAt])
  @@map("wa_conversations")
}

/// Intent de pago de una cita vía QR Simple.
/// Relación 1:N con Appointment: cada reintento crea un nuevo intent y se
/// preserva el historial (los anteriores quedan EXPIRED/FAILED). Solo uno
/// debería estar PENDING a la vez por cita.
model PaymentIntent {
  id            String      @id @default(uuid())
  tenantId      String
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  /// Monto congelado al emitir el intent (snapshot del precio del servicio).
  /// Bloquea cambios de precio: aunque Service.price cambie luego, este monto
  /// es inmutable para este intent.
  amount   Decimal       @db.Decimal(10, 2)
  currency String        @default("BOB") /// Bolivianos
  status   PaymentStatus @default(PENDING)

  /// ID del cobro en el proveedor (QR Simple). Único para conciliación.
  providerPaymentId String? @unique
  /// Payload del QR (texto EMV o URL) para renderizar la imagen en el cliente.
  qrPayload         String? @db.Text

  expiresAt DateTime
  paidAt    DateTime?

  events PaymentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([appointmentId])
  @@index([status, expiresAt]) /// Para el cron de expiración de intents PENDING
  @@index([providerPaymentId])
  @@map("payment_intents")
}

/// Registro de "hay una reserva pública nueva que notificar a la clínica".
/// Stub para el bot futuro: hoy solo se registra; el aviso a la clínica lo
/// manda el propio paciente vía el link de WhatsApp del paso confirmado.
model BookingNotification {
  id            String   @id @default(uuid())
  tenantId      String
  appointmentId String   @unique
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@map("booking_notifications")
}

/// Evento de webhook del proveedor de pagos. Guarda el payload crudo para
/// auditoría y deduplica por `eventId` (idempotencia de webhooks).
model PaymentEvent {
  id              String         @id @default(uuid())
  /// Puede ser null si el webhook llega antes de poder asociar el intent.
  tenantId        String?
  paymentIntentId String?
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  /// ID del evento en el proveedor — clave de deduplicación.
  eventId    String @unique
  eventType  String /// ej: "payment.succeeded", "payment.failed"
  rawPayload Json /// Payload completo recibido, para auditoría

  processedAt DateTime? /// null = recibido pero aún no procesado

  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([paymentIntentId])
  @@map("payment_events")
}
