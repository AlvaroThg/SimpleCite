{
  "uid": "simplecite-logs",
  "title": "SimpleCite — API & Logs",
  "tags": ["simplecite", "logs", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Contenedor",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(container_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Requests/s (API)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({container_name=~\"$container\"} |= \"request completed\" [5m]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Latencia p95",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(quantile_over_time(0.95, {container_name=~\"$container\"} |= \"request completed\" | json | unwrap responseTime [5m]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Errores (rango)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({container_name=~\"$container\", level=\"error\"} [$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Warnings (rango)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({container_name=~\"$container\", level=\"warn\"} [$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "401/403 (rango)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({container_name=~\"$container\"} |= \"request completed\" | json | res_statusCode=~\"401|403\" [$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "5xx (rango)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({container_name=~\"$container\"} |= \"request completed\" | json | res_statusCode=~\"5..\" [$__range]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP status por código (rate)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (res_statusCode) (rate({container_name=~\"$container\"} |= \"request completed\" | json [5m]))",
          "legendFormat": "{{res_statusCode}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latencia (ms)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 5 } }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(quantile_over_time(0.95, {container_name=~\"$container\"} |= \"request completed\" | json | unwrap responseTime [5m]))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "max(quantile_over_time(0.99, {container_name=~\"$container\"} |= \"request completed\" | json | unwrap responseTime [5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests/s en el tiempo",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15 } }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({container_name=~\"$container\"} |= \"request completed\" [5m]))",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Logs por nivel (rate)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (rate({container_name=~\"$container\"} [5m]))",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top endpoints (rango)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "topk(10, sum by (req_url) (count_over_time({container_name=~\"$container\"} |= \"request completed\" | json [$__range])))"
        }
      ],
      "options": { "showHeader": true }
    },
    {
      "type": "table",
      "title": "Errores HTTP 4xx/5xx por endpoint (rango)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum by (req_url, res_statusCode) (count_over_time({container_name=~\"$container\"} |= \"request completed\" | json | res_statusCode=~\"4..|5..\" [$__range]))"
        }
      ],
      "options": { "showHeader": true }
    },
    {
      "type": "logs",
      "title": "Errores recientes",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "targets": [
        { "refId": "A", "expr": "{container_name=~\"$container\", level=\"error\"} | json" }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "type": "logs",
      "title": "Logs (todos)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 36 },
      "targets": [{ "refId": "A", "expr": "{container_name=~\"$container\"} | json" }],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
