# =============================================================================
# Axon Observability — Environment Variables
# =============================================================================

# ── Security ────────────────────────────────────────────────────────────────
# Token para autenticar Prometheus contra /metrics del backend
# DEBE ser el mismo valor que METRICS_TOKEN en el backend (.env)
# Generar con: openssl rand -hex 32
METRICS_TOKEN=your-shared-secret-token-here

# ── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_ROOT_URL=https://grafana.your-domain.com

# ── Loki ────────────────────────────────────────────────────────────────────
LOKI_RETENTION_PERIOD=744h

# ── Alertmanager ────────────────────────────────────────────────────────────
# URL pública de Alertmanager (opcional, para links en notificaciones)
ALERTMANAGER_EXTERNAL_URL=https://alertmanager.your-domain.com

# ── Slack Notifications ─────────────────────────────────────────────────────
# Webhook URL de Slack para notificaciones de alertas
# Crear en: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ── Email Notifications ─────────────────────────────────────────────────────
# Configuración SMTP para alertas por email
ALERT_EMAIL_TO=alerts@your-domain.com
ALERT_EMAIL_FROM=alertmanager@your-domain.com
ALERT_EMAIL_SMARTHOST=smtp.gmail.com:587
ALERT_EMAIL_USERNAME=your-email@gmail.com
ALERT_EMAIL_PASSWORD=your-app-password
